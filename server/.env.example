# Plantilla REMOTA. Para Docker: npm run setup -- --local, luego npm run dev.
# No versionar el archivo completado. npm run setup -- --remote crea .env.remote.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Utiliza solo la clave pública anon/publishable. Nunca coloques service_role aquí.
SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA
PORT=3000
NODE_ENV=development
# Genera al menos 32 caracteres aleatorios. Mismo valor entre instancias.
SESSION_SECRET=GENERAR_UN_SECRETO_ALEATORIO_PRIVADO
# Usuario privado del almacén. TLS verificado obligatorio en producción remota.
SESSION_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE?sslmode=verify-full
# Exclusiva de Auth Admin: secret/service_role del proveedor. Nunca anon ni frontend.
# Express verifica rol antes de usarla. SQL siempre usa JWT del usuario y RLS.
SUPABASE_AUTH_ADMIN_KEY=
