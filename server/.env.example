# Backend REMOTO (Auth, PostgreSQL, Storage, Edge Functions).
# Para backend local usa npm run local:config y npm run start:local.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Utiliza solo la clave pública anon/publishable. Nunca coloques service_role aquí.
SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA
PORT=3000
# Obligatorios con NODE_ENV=production o en Vercel. Valores ficticios: reemplazar.
# Genera SESSION_SECRET de forma privada, con al menos 32 caracteres aleatorios.
# SESSION_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_PRIVADO
# Conexión PostgreSQL privada con acceso a application_sessions; usar TLS remoto.
# SESSION_DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE?sslmode=verify-full
